<?xml version="1.0"?>
<sdf version="1.6">

  <world name="canyon_world">

    <!-- 地面 -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- 光照 -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- 场景背景 -->
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.75 0.8 1</background>
    </scene>

    <!-- 自定义峡谷墙壁 -->
    <model name="canyon_walls">
      <static>true</static>

      <!-- 左侧外墙 -->
      <link name="west_wall">
        <pose>-1 1.5 0.4 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.18 5.3 0.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.18 5.3 0.8</size>
            </box>
          </geometry>
        </visual>
      </link>

      <!-- 右侧外墙 -->
      <link name="east_wall">
        <pose>6 1.5 0.4 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.18 5.3 0.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.18 5.3 0.8</size>
            </box>
          </geometry>
        </visual>
      </link>

      <!-- 下侧外墙 -->
      <link name="south_wall">
        <pose>2.5 -1 0.4 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>7.2 0.18 0.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>7.2 0.18 0.8</size>
            </box>
          </geometry>
        </visual>
      </link>

      <!-- 上侧外墙 -->
      <link name="north_wall">
        <pose>2.5 4 0.4 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>7.2 0.18 0.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>7.2 0.18 0.8</size>
            </box>
          </geometry>
        </visual>
      </link>

      <!-- 第一处峡谷隔墙 -->
      <link name="inner_wall_1">
        <pose>1.5 0.55 0.4 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.18 3.1 0.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.18 3.1 0.8</size>
            </box>
          </geometry>

          <material>
            <ambient>0.58 0.45 0.32 1</ambient>
            <diffuse>0.65 0.52 0.38 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- 第二处峡谷隔墙 -->
      <link name="inner_wall_2">
        <pose>3.4 2.45 0.4 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.18 3.1 0.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.18 3.1 0.8</size>
            </box>
          </geometry>

          <material>
            <ambient>0.58 0.45 0.32 1</ambient>
            <diffuse>0.65 0.52 0.38 1</diffuse>
          </material>
        </visual>
      </link>

    </model>

    <!-- 绿色起点标记 -->
    <model name="start_marker">
      <static>true</static>

      <link name="start_link">
        <pose>0 0 0.012 0 0 0</pose>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.23</radius>
              <length>0.015</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>0 0.8 0.2 1</ambient>
            <diffuse>0 0.8 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 黄色终点标记 -->
    <model name="finish_marker">
      <static>true</static>

      <link name="finish_link">
        <pose>4.5 3.0 0.012 0 0 0</pose>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.23</radius>
              <length>0.015</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>1 0.65 0 1</ambient>
            <diffuse>1 0.65 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>

</sdf>
