<?xml version="1.0"?>
<sdf version="1.6">

  <model name="test_obstacle">

    <!-- 静态障碍物，不会被机器人撞走 -->
    <static>true</static>

    <link name="block">

      <!-- 方块中心距地面0.25m -->
      <pose>0 0 0.25 0 0 0</pose>

      <!-- 碰撞模型 -->
      <collision name="collision">
        <geometry>
          <box>
            <size>0.40 0.40 0.50</size>
          </box>
        </geometry>
      </collision>

      <!-- 可视化模型 -->
      <visual name="visual">
        <geometry>
          <box>
            <size>0.40 0.40 0.50</size>
          </box>
        </geometry>

        <!-- 橙色障碍物 -->
        <material>
          <ambient>1.0 0.35 0.05 1</ambient>
          <diffuse>1.0 0.35 0.05 1</diffuse>
        </material>
      </visual>

    </link>

  </model>

</sdf>