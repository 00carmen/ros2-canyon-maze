<?xml version="1.0"?>
<sdf version="1.6">

  <world name="canyon_maze">

    <!-- ========================= -->
    <!-- 1. 地面和光照 -->
    <!-- ========================= -->

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.75 0.8 1</background>
    </scene>

    <!-- ========================= -->
    <!-- 2. 迷宫墙体 -->
    <!-- ========================= -->

    <model name="canyon_walls">
      <static>true</static>

      <!-- 西侧外墙 -->
      <link name="west_wall">
        <pose>-1.0 1.5 0.4 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.18 5.3 0.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.18 5.3 0.8</size>
            </box>
          </geometry>
        </visual>
      </link>

      <!-- 东侧外墙 -->
      <link name="east_wall">
        <pose>6.0 1.5 0.4 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.18 5.3 0.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.18 5.3 0.8</size>
            </box>
          </geometry>
        </visual>
      </link>

      <!-- ========================= -->
      <!-- 南侧外墙：设置入口 -->
      <!-- 入口中心 (0, -1) -->
      <!-- 入口宽度 1.0m -->
      <!-- ========================= -->

      <!-- 南侧左段 -->
      <link name="south_wall_left">
        <pose>-0.8 -1.0 0.4 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.6 0.18 0.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.6 0.18 0.8</size>
            </box>
          </geometry>
        </visual>
      </link>

      <!-- 南侧右段 -->
      <link name="south_wall_right">
        <pose>3.3 -1.0 0.4 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>5.6 0.18 0.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>5.6 0.18 0.8</size>
            </box>
          </geometry>
        </visual>
      </link>

      <!-- ========================= -->
      <!-- 北侧外墙：设置出口 -->
      <!-- 出口中心 (4.5, 4.0) -->
      <!-- 出口宽度 1.0m -->
      <!-- ========================= -->

      <!-- 北侧左段 -->
      <link name="north_wall_left">
        <pose>1.45 4.0 0.4 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>5.1 0.18 0.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>5.1 0.18 0.8</size>
            </box>
          </geometry>
        </visual>
      </link>

      <!-- 北侧右段 -->
      <link name="north_wall_right">
        <pose>5.55 4.0 0.4 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>1.1 0.18 0.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.1 0.18 0.8</size>
            </box>
          </geometry>
        </visual>
      </link>

      <!-- ========================= -->
      <!-- 内部S型隔墙 -->
      <!-- ========================= -->

      <!-- 第一面隔墙：从南侧向北延伸 -->
      <link name="inner_wall_1">
        <pose>1.5 0.55 0.4 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.18 3.1 0.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.18 3.1 0.8</size>
            </box>
          </geometry>

          <material>
            <ambient>0.58 0.45 0.32 1</ambient>
            <diffuse>0.65 0.52 0.38 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- 第二面隔墙：从北侧向南延伸 -->
      <link name="inner_wall_2">
        <pose>3.4 2.45 0.4 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.18 3.1 0.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.18 3.1 0.8</size>
            </box>
          </geometry>

          <material>
            <ambient>0.58 0.45 0.32 1</ambient>
            <diffuse>0.65 0.52 0.38 1</diffuse>
          </material>
        </visual>
      </link>

    </model>

    <!-- ========================= -->
    <!-- 3. 绿色入口标记 -->
    <!-- 入口外侧 (0, -1.5) -->
    <!-- ========================= -->

    <model name="start_marker">
      <static>true</static>

      <link name="start_link">
        <pose>0 -1.5 0.012 0 0 0</pose>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.23</radius>
              <length>0.015</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>0 0.8 0.2 1</ambient>
            <diffuse>0 0.8 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================= -->
    <!-- 4. 黄色出口标记 -->
    <!-- 出口外侧 (4.5, 4.55) -->
    <!-- ========================= -->

    <model name="finish_marker">
      <static>true</static>

      <link name="finish_link">
        <pose>4.5 4.55 0.012 0 0 0</pose>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.23</radius>
              <length>0.015</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>1 0.65 0 1</ambient>
            <diffuse>1 0.65 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>

</sdf>
